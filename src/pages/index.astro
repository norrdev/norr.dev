---
import Layout from "../layouts/Layout.astro";

const projects = [
  {
    name: "Rune",
    subtitle: "Runestone Safari",
    description:
      "Interactive runestone map with 6,815+ runestones, search, and offline caching.",
    url: "https://github.com/norrdev/rune",
    tags: ["Expo", "React Native", "Interactive Map", "Offline"]
  },
  {
    name: "OpenGym",
    description:
      "Cross-platform workout journal and private digital trainer with no tracking.",
    url: "https://github.com/norrdev/OpenGym",
    tags: ["Cross-platform", "SQLite", "Privacy-first", "Fitness"]
  }
];

const year = new Date().getFullYear();
---

<Layout>
  <header class="site-header reveal">
    <a class="brand" href="/" aria-label="norr.dev — home">
      <img src="/images/avatar.png" alt="" class="brand-mark" width="192" height="192" />
      <span class="brand-name">norr<span>.dev</span></span>
    </a>
    <a class="header-link" href="https://github.com/norrdev" target="_blank" rel="noreferrer">GitHub</a>
  </header>

  <section class="hero reveal">
    <h1>Crafting side-projects, utility tools, and open-source solutions.</h1>
    <p class="lede">
      norr.dev is an independent personal lab for building useful products, sharing the engineering
      journey, and shipping production-ready code often.
    </p>
  </section>

  <section class="section reveal delay-1" aria-labelledby="projects-title">
    <h2 id="projects-title" class="label">Featured projects</h2>
    <ul class="projects">
      {
        projects.map((project, i) => (
          <li>
            <a class="project" href={project.url} target="_blank" rel="noreferrer">
              <span class="project-index">{String(i + 1).padStart(2, "0")}</span>
              <div class="project-body">
                <h3>
                  {project.name}
                  {project.subtitle && <span class="project-subtitle">{project.subtitle}</span>}
                </h3>
                <p>{project.description}</p>
                <ul class="tags" aria-label="Tags">
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </div>
              <svg class="project-arrow" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7" /><path d="M8 7h9v9" /></svg>
              <span class="visually-hidden">(opens GitHub in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <figure class="scene reveal delay-2">
    <img src="/images/scene.png" alt="Low-poly tabby cat sitting by a Nordic fjord" width="440" height="395" loading="lazy" decoding="async" />
  </figure>

  <footer class="footer reveal delay-2">
    <span class="footer-copy">© {year} norr.dev</span>
    <nav class="footer-links" aria-label="Contact">
      <a href="https://github.com/norrdev" target="_blank" rel="noreferrer">GitHub</a>
      <a href="mailto:mail@norr.dev">mail@norr.dev</a>
    </nav>
  </footer>
</Layout>
